# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# Long random strings. Generate each with:  openssl rand -hex 24
MM_DB_PASSWORD=change-me
RECEIVER_TOKEN=change-me

# Only events from this repository are accepted (OWNER/REPO). Empty = any.
ALLOWED_REPOSITORY=your-github-username/devsecops-pipeline

# Incoming webhooks created in Mattermost (chapter 9). Replace the host part
# "localhost:8065" with "mattermost:8065" so the worker container can reach it.
MM_WEBHOOK_HIGH=http://mattermost:8065/hooks/replace-me
MM_WEBHOOK_REVIEW=http://mattermost:8065/hooks/replace-me
MM_WEBHOOK_STATUS=http://mattermost:8065/hooks/replace-me

# Optional: pin image versions (recommended once things work)
# KAFKA_TAG=3.9.0
# KAFKA_UI_TAG=v1.5.0
# MATTERMOST_TAG=latest
